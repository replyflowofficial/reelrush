# ============================================================================
# ReelRush — Environment Configuration Example
# ============================================================================
# Copy this file to .env (or apps/server/.env and apps/mobile/.env)

# ----------------------------------------------------------------------------
# Mobile App Configuration (Expo)
# ----------------------------------------------------------------------------
# Backend API Base URL:
# - iOS Simulator / Web:         http://localhost:4000
# - Android Emulator (AVD):      http://10.0.2.2:4000
# - Physical Device (LAN IP):    http://192.168.1.XXX:4000
BACKEND_URL=http://10.0.2.2:4000
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:4000

# ----------------------------------------------------------------------------
# Backend Server Configuration (/apps/server)
# ----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Optional: Explicit path to yt-dlp binary if not in system PATH
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Security & Resource Limits
MAX_CONCURRENT_DOWNLOADS=3
MAX_FILE_SIZE_MB=150
DOWNLOAD_TIMEOUT_MS=60000
TEMP_FILE_TTL_MS=600000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=15
